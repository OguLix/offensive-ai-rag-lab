# Salin file ini menjadi .env lalu isi bila perlu. Jangan pernah commit .env.
# Semua nilai di sini hanya untuk mesin lokal; tidak ada kredensial nyata.

# Alamat Ollama. Harus loopback; jangan diarahkan ke host lain.
OLLAMA_HOST=http://127.0.0.1:11434

# Path alternatif ke settings.yaml. Kosongkan untuk memakai config/settings.yaml.
RAGBOT_SETTINGS_PATH=

# Kunci Flask. Isi dengan nilai acak lokal bila nanti dibutuhkan; bukan kredensial nyata.
FLASK_SECRET_KEY=
